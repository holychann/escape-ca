# Copy to .env (never commit it). The car app never sees any of these.
# One key is enough. With GEMINI_API_KEY filled in, the server uses Gemini unless STORY_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# STORY_PROVIDER=claude        # claude | gemini, when both keys are filled in
# STORY_MODEL=                 # default claude-opus-5-5 / gemini-3.6-flash
# STORY_DAILY_PER_INSTALL=20
# STORY_DAILY_PER_IP=200
# STORY_DATA_DIR=data
# IMAGE_MODEL=gemini-nano-banana-2.1   # draws the pictures for a family's story wish (needs GEMINI_API_KEY); off = no pictures
# TTS_MODEL=gemini-3.8-flash-tts       # reads Lumi's lines aloud in a picture-book voice (needs GEMINI_API_KEY); off = the car's own voice
# TTS_VOICE=Leda                       # Gemini voice name; compare with: python -m tools.tts_sample --plain
# TTS_STYLE=                           # how to read (English); empty = the warm storyteller style in app/voice.py
# TTS_DAILY_MAX=100                    # speech calls a day at most; a 429 from the free quota also stops them
