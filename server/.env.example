# Copy to .env (never commit it). The car app never sees any of these.
# Three keys, each with its own job:
#   ANTHROPIC_API_KEY    writes the script (story and lines) with Claude
#   GEMINI_API_KEY       the free Gemini key: reads the lines aloud (TTS) within the free limits
#   GEMINI_API_KEY_PAID  the paid Gemini key: draws the pictures, and reads a line aloud when the free key is used up
#                        or fails (once, no daily limit of its own). Empty: no AI pictures, and such a line is a caption
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
# STORY_PROVIDER=claude        # claude (default) | gemini = write with the free Gemini key instead, for trying only
# STORY_MODEL=                 # default claude-opus-5-5 / gemini-3.6-flash
# STORY_EFFORT=medium          # low | medium | high (reasoning effort for story writing)
# STORY_DAILY_PER_INSTALL=20
# STORY_DAILY_PER_IP=200
# STORY_DAILY_TOTAL=300        # server-wide daily cap to bound total API spend
# STORY_REPORT_PER_IP=30
# STORY_REPORT_DAILY_TOTAL=500
# STORY_IMAGE_TTL_HOURS=24     # auto-delete generated episode WebP folders older than this (0 = keep)
# STORY_AUDIO_TTL_HOURS=72     # auto-delete cached TTS WAV files older than this (0 = keep)
# STORY_AUDIO_MAX_FILES=2000   # cap total cached TTS WAV files on disk (oldest evicted first)
# STORY_TRUST_PROXY=0          # set 1 behind Cloud Run / Fly.io / Render / Nginx reverse proxy
# STORY_DATA_DIR=data
# STORY_DOMAIN=story.example.com   # only for compose.yaml: the address Caddy gets the HTTPS certificate for (배포_방법.md)
# IMAGE_MODEL=gemini-nano-banana-2.1   # draws the pictures for a family's story wish (needs GEMINI_API_KEY_PAID); off = no pictures
# IMAGE_EFFORT=minimal         # minimal | low | medium | high | off (thinking level for image generation; gemini-nano-banana-2.1 refuses low)
# TTS_MODEL=gemini-3.8-flash-tts       # reads the lines aloud in a picture-book voice (GEMINI_API_KEY first, then GEMINI_API_KEY_PAID); off = captions only
# Lumi's voice: a Korean storyteller from the voice library (check a name with: python -m tools.tts_voices <name>)
TTS_VOICE=ko-kr-storyteller-4
# how to read (English); sent only as the style, never mixed into the words that are read aloud
TTS_STYLE="Read in Korean like a warm, playful storyteller reading a picture book to a 5-year-old. Slightly brisk, lively pace. Big rises and falls in pitch, excited on exclamations, curious and rising on questions, a quick little whisper on secret parts."
# TTS_DAILY_MAX=10                     # free-key speech calls a day (the free tier allows 10); then the paid key
# TTS_PAID_RPM=8                       # paid-key speech calls a minute; more wait for room instead of failing
# IMAGE_RPM=60                         # paid-key pictures a minute, same waiting (Google allows 100)
# IMAGE_PARALLEL=2                     # pictures of one episode drawn at the same time
# SPEAK_DAILY_PER_INSTALL=400            # lines read aloud a day per car (guards the paid key)
# SPEAK_DAILY_PER_IP=2000
# SPEAK_DAILY_TOTAL=20000               # lines read aloud a day, whole server
# The story shelf: stories written by the writer are kept for other cars (all optional; off when neither BUCKET nor DIR is set)
# STORY_LIBRARY_BUCKET=         # S3 bucket for the shelf (stories only, no pictures, no install ids)
# STORY_LIBRARY_PREFIX=         # folder inside the bucket, default empty
# STORY_LIBRARY_DIR=            # a local folder instead of S3, for development
# STORY_LIBRARY_MODELS=claude   # writer model name prefixes allowed on the shelf (comma separated; empty = all)
# STORY_LIBRARY_CAP=200         # most stories kept per cell (friend, youngest age, minutes)
# STORY_LIBRARY_MIN=30          # a cell with fewer stories sometimes asks the car for a new one
# STORY_LIBRARY_FRESH=0.3       # chance of that, below MIN
# STORY_LIBRARY_CANDIDATES=10   # stories offered to a car at once
# STORY_LIBRARY_PER_IP=500      # shelf requests per address per day
# STORY_LIBRARY_BLOCKS_PER_IP=5 # stories one address can take off the shelf per day by reporting
# STORY_LIBRARY_LOAD_SECONDS=60 # longest the server waits at start to read the shelf; it then starts with what it has read
# AWS_ACCESS_KEY_ID=            # standard boto3 variables for the bucket (names only here, never values)
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
