# Copy to .env (never commit it). The car app never sees any of these.
# One key is enough. With GEMINI_API_KEY filled in, the server uses Gemini unless STORY_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# STORY_PROVIDER=claude        # claude | gemini, when both keys are filled in
# STORY_MODEL=                 # default claude-opus-5-5 / gemini-3.6-flash
# STORY_DAILY_PER_INSTALL=20
# STORY_DAILY_PER_IP=200
# STORY_DAILY_TOTAL=300        # server-wide daily cap to bound total API spend
# STORY_REPORT_PER_IP=30
# STORY_REPORT_DAILY_TOTAL=500
# STORY_IMAGE_TTL_HOURS=24     # auto-delete generated episode WebP folders older than this (0 = keep)
# STORY_TRUST_PROXY=0          # set 1 behind Cloud Run / Fly.io / Render / Nginx reverse proxy
# STORY_DATA_DIR=data
# STORY_DOMAIN=story.example.com   # only for compose.yaml: the address Caddy gets the HTTPS certificate for (배포_방법.md)
# IMAGE_MODEL=gemini-nano-banana-2.1   # draws the pictures for a family's story wish (needs GEMINI_API_KEY); off = no pictures
# The story shelf: stories written by the writer are kept for other cars (all optional; off when neither BUCKET nor DIR is set)
# STORY_LIBRARY_BUCKET=...
# STORY_LIBRARY_PREFIX=...
# STORY_LIBRARY_DIR=...
# STORY_LIBRARY_MODELS=claude
# STORY_LIBRARY_CAP=200
# STORY_LIBRARY_MIN=30
# STORY_LIBRARY_FRESH=0.3
# STORY_LIBRARY_CANDIDATES=10
# STORY_LIBRARY_PER_IP=500
# STORY_LIBRARY_BLOCKS_PER_IP=5
