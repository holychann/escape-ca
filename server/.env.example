# Copy to .env (never commit it). The car app never sees any of these.
# One key is enough. With GEMINI_API_KEY filled in, the server uses Gemini unless STORY_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Used only when the free key above is refused (429) or fails; no daily limit of its own. Leave empty to
# never pay: a line the free key cannot make is then shown as a caption.
GEMINI_API_KEY_PAID=
# STORY_PROVIDER=claude        # claude | gemini, when both keys are filled in
# STORY_MODEL=                 # default claude-opus-5-5 / gemini-3.6-flash
# STORY_DAILY_PER_INSTALL=20
# STORY_DAILY_PER_IP=200
# STORY_DATA_DIR=data
# IMAGE_MODEL=gemini-nano-banana-2.1   # draws the pictures for a family's story wish (needs GEMINI_API_KEY); off = no pictures
# TTS_MODEL=gemini-3.8-flash-tts       # reads Lumi's lines aloud in a picture-book voice (needs GEMINI_API_KEY); off = the car's own voice
# Lumi's voice: a Korean storyteller from the voice library (check a name with: python -m tools.tts_voices <name>)
TTS_VOICE=ko-kr-storyteller-4
# how to read (English); sent only as the style, never mixed into the words that are read aloud
TTS_STYLE="Read in Korean like a warm, playful storyteller reading a picture book to a 5-year-old. Slightly brisk, lively pace. Big rises and falls in pitch, excited on exclamations, curious and rising on questions, a quick little whisper on secret parts."
# TTS_DAILY_MAX=100                    # free-key speech calls a day at most; a 429 also stops them (not for the paid key)
# SPEAK_DAILY_PER_INSTALL=400            # lines read aloud a day per car (guards the paid key)
# SPEAK_DAILY_PER_IP=2000
